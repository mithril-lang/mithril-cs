{:paths ["src"]
 :mvn/repos {"central" {:url "https://repo.maven.apache.org/maven2/"}}
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases {:test {:extra-paths ["test"] :main-opts ["-m" "mithril.cs.test-runner"]}
           :run {:main-opts ["-m" "mithril.cs.cli"]}
           :edge-build {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}} :main-opts ["-m" "mithril.cs.edge-build"]}
           :cljs-test {:extra-paths ["test"]
                       :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}
                       :main-opts ["-m" "mithril.cs.cljs-build"]}}}
