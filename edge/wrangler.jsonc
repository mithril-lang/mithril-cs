{
 "$schema":"https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
 "name":"mithril-cs",
 "account_id":"62e1fda53188460698f8c66d3aef59c6",
 "main":"worker.mjs",
 "compatibility_date":"2026-11-14",
 "compatibility_flags":["global_fetch_strictly_public"],
 "workers_dev":false,
 "routes":[{"pattern":"cs.mithril.fund","custom_domain":true}],
 "services":[{"binding":"AUTH","service":"mithril-auth"},{"binding":"WORKSPACE","service":"mithril-api"}],
 "r2_buckets":[{"binding":"EVIDENCE","bucket_name":"mithril-cs-evidence"}],
 "vars":{"ALLOWED_HOSTS":"mithril.fund,cs.mithril.fund","SOURCE_SHA":"SET_BY_SOURCE_BOUND_PUBLISHER"},
 "observability":{"enabled":true,"head_sampling_rate":0.1,"logs":{"enabled":true,"invocation_logs":false},"traces":{"enabled":false}},
 // D1 binding CS_DB is supplied with the source-bound dedicated database ID at publication.
 // No production auth identity database is writable through this Worker.
 "limits":{"cpu_ms":500}
}
